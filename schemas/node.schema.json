{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/node.schema.json",
  "title": "Jiangxi Travel Knowledge Node Schema 2.0",
  "type": "object",
  "required": ["id", "name", "aliases", "node_type", "category", "tags", "sources", "metadata"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "city": {
      "type": "string"
    },
    "city_id": {
      "type": "string",
      "pattern": "^city_[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "node_type": {
      "enum": [
        "city",
        "journey",
        "itinerary",
        "attraction",
        "museum",
        "memorial",
        "permanent_exhibition",
        "temporary_exhibition",
        "artifact",
        "collection_group",
        "history_event",
        "historic_site",
        "archaeological_site",
        "food",
        "accommodation_area",
        "transport"
      ]
    },
    "parent_id": {
      "type": ["string", "null"]
    },
    "category": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "related_node_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1},
          "scope": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "source_type": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "media": {
      "type": "object",
      "required": ["cover", "gallery"],
      "properties": {
        "cover": {"anyOf": [{"$ref": "#/$defs/mediaAsset"}, {"type": "null"}]},
        "gallery": {
          "type": "array",
          "items": {"$ref": "#/$defs/mediaAsset"}
        }
      },
      "additionalProperties": false
    },
    "ai_score": {
      "type": "object",
      "additionalProperties": {
        "type": ["integer", "null"],
        "minimum": 1,
        "maximum": 5
      }
    },
    "holiday_reference": {
      "type": "object",
      "required": [
        "target_year",
        "status",
        "reference_year",
        "period",
        "observed_facts",
        "planning_inference",
        "sources",
        "confidence",
        "recheck_required"
      ],
      "properties": {
        "target_year": {"type": "integer"},
        "status": {"const": "historical_reference_only"},
        "reference_year": {"type": "integer"},
        "period": {
          "type": "object",
          "required": ["start", "end"],
          "properties": {
            "start": {"type": "string", "format": "date"},
            "end": {"type": "string", "format": "date"}
          }
        },
        "observed_facts": {"type": "object"},
        "planning_inference": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1,
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "url", "source_type"],
            "properties": {
              "name": {"type": "string"},
              "url": {"type": "string"},
              "source_type": {
                "enum": ["official", "official_republication", "official_statistics"]
              }
            }
          },
          "minItems": 1
        },
        "confidence": {
          "enum": ["low", "low-medium", "medium", "medium-high", "high"]
        },
        "recheck_required": {"const": true},
        "recheck_window": {
          "type": "array",
          "items": {"type": "string", "format": "date"},
          "minItems": 2,
          "maxItems": 2
        },
        "warning": {"type": "string"}
      },
      "additionalProperties": false
    },
    "experience_layer": {
      "type": "object",
      "required": [
        "source",
        "confidence",
        "positive",
        "avoid",
        "visit_tips",
        "crowd_model",
        "ai_note"
      ],
      "properties": {
        "source": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1,
          "uniqueItems": true
        },
        "confidence": {
          "type": "object",
          "required": ["overall"],
          "properties": {
            "overall": {
              "enum": ["low", "low-medium", "medium", "medium-high", "high"]
            },
            "reason": {"type": "string"}
          },
          "additionalProperties": true
        },
        "positive": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["content", "type"]
          }
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["content", "risk", "severity"]
          }
        },
        "visit_tips": {
          "type": "array",
          "items": {"type": "string"}
        },
        "crowd_model": {"type": "object"},
        "recommended_duration": {
          "type": "object",
          "required": ["minimum_minutes", "recommended_min_minutes", "recommended_max_minutes"]
        },
        "ai_note": {"type": "string"}
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "required": [
        "schema_version",
        "content_status",
        "verification_level",
        "time_sensitivity",
        "last_verified_at",
        "next_review_at"
      ],
      "properties": {
        "schema_version": {"const": "2.0"},
        "content_status": {
          "enum": [
            "draft",
            "candidate",
            "complete",
            "needs_update",
            "archived"
          ]
        },
        "verification_level": {
          "enum": ["unverified", "experience_only", "third_party", "official", "mixed", "historical"]
        },
        "time_sensitivity": {
          "enum": ["low", "medium", "high", "critical"]
        },
        "last_verified_at": {
          "type": ["string", "null"],
          "format": "date"
        },
        "next_review_at": {
          "type": ["string", "null"],
          "format": "date"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "mediaAsset": {
      "type": "object",
      "required": [
        "asset_id",
        "path",
        "type",
        "alt",
        "source_type",
        "source_name",
        "source_url",
        "license",
        "credit",
        "verified_at"
      ],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
        "path": {"type": "string", "pattern": "^/images/"},
        "type": {
          "enum": [
            "exterior", "interior", "exhibition_hall", "artifact", "viewpoint",
            "night_view", "food", "street_environment", "transport_entrance",
            "accommodation_environment"
          ]
        },
        "alt": {"type": "string", "minLength": 4},
        "source_type": {"enum": ["official", "open_license", "self_produced", "user_provided"]},
        "source_name": {"type": "string", "minLength": 1},
        "source_url": {"type": ["string", "null"]},
        "license": {"type": "string", "minLength": 1},
        "credit": {"type": ["string", "null"]},
        "verified_at": {"type": "string", "format": "date"},
        "focal_point": {
          "type": "object",
          "required": ["x", "y"],
          "properties": {
            "x": {"type": "number", "minimum": 0, "maximum": 1},
            "y": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["experience_layer"],
        "properties": {
          "node_type": {"not": {"const": "accommodation_area"}}
        }
      },
      "then": {
        "properties": {
          "experience_layer": {"required": ["recommended_duration"]}
        }
      }
    }
  ]
}
